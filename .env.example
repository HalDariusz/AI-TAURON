# AI-TAURON Environment Variables
# Copy to .env and fill in values

# PostgreSQL
POSTGRES_PASSWORD=changeme
POSTGRES_USER=ai_tauron
POSTGRES_DB=ai_tauron
POSTGRES_DSN=postgresql://ai_tauron:changeme@localhost:5432/ai_tauron

# Qdrant
QDRANT_URL=http://localhost:6333
LEGAL_ACTS_COLLECTION=legal_acts
CONTRACTS_COLLECTION=contracts

# Ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL_NAME=mistral
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120.0

# Embedding
EMBEDDING_MODEL_NAME=sdadas/mmlw-roberta-large

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=ai-tauron-compliance

# RAG
RETRIEVAL_TOP_K=10
CHUNK_MAX_TOKENS=1024
CHUNK_MIN_TOKENS=128

# Hyperledger Fabric
HLF_ENABLED=false
HLF_GATEWAY_URL=http://localhost:3001
HLF_CHANNEL=compliance-channel
HLF_CHAINCODE=compliance-registry
